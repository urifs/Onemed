{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "destination": "https://onemedcursos.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "destination": "https://onemedcursos.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
